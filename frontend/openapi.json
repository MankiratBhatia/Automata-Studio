  "components": {
    "schemas": {
      "Automaton": {
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion",
            "default": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "DFA",
              "NFA",
              "ENFA"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "title": "Name",
            "default": ""
          },
          "alphabet": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Alphabet"
          },
          "states": {
            "items": {
              "$ref": "#/components/schemas/State"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "States"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "accepting": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepting"
          },
          "transitions": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "maxItems": 20000,
            "title": "Transitions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "alphabet",
          "states",
          "start",
          "accepting",
          "transitions"
        ],
        "title": "Automaton"
      },
      "BatchItem": {
        "properties": {
          "input": {
            "type": "string",
            "title": "Input"
          },
          "accepted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "input",
          "accepted",
          "error"
        ],
        "title": "BatchItem"
      },
      "BatchRequest": {
        "properties": {
          "automaton": {
            "$ref": "#/components/schemas/Automaton"
          },
          "inputs": {
            "items": {
              "type": "string",
              "maxLength": 2000
            },
            "type": "array",
            "maxItems": 500,
            "title": "Inputs"
          }
        },
        "type": "object",
        "required": [
          "automaton",
          "inputs"
        ],
        "title": "BatchRequest"
      },
      "BatchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "BatchResponse"
      },
      "ConvertResponse": {
        "properties": {
          "automaton": {
            "$ref": "#/components/schemas/Automaton"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepOut"
            },
            "type": "array",
            "title": "Steps"
          },
          "stateMap": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Statemap"
          },
          "rounds": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rounds"
          }
        },
        "type": "object",
        "required": [
          "automaton",
          "steps"
        ],
        "title": "ConvertResponse"
      },
      "EquivalenceRequest": {
        "properties": {
          "a": {
            "$ref": "#/components/schemas/Automaton"
          },
          "b": {
            "$ref": "#/components/schemas/Automaton"
          }
        },
        "type": "object",
        "required": [
          "a",
          "b"
        ],
        "title": "EquivalenceRequest"
      },
      "EquivalenceResponse": {
        "properties": {
          "equivalent": {
            "type": "boolean",
            "title": "Equivalent"
          },
          "counterexample": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counterexample"
          },
          "aAccepts": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aaccepts"
          },
          "bAccepts": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baccepts"
          },
          "explored": {
            "type": "integer",
            "title": "Explored"
          }
        },
        "type": "object",
        "required": [
          "equivalent",
          "counterexample",
          "aAccepts",
          "bAccepts",
          "explored"
        ],
        "title": "EquivalenceResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "issues": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/IssueOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "IssueOut": {
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ],
            "title": "Severity"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "stateIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stateids"
          },
          "transitionIndices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Transitionindices"
          }
        },
        "type": "object",
        "required": [
          "severity",
          "code",
          "message",
          "stateIds",
          "transitionIndices"
        ],
        "title": "IssueOut"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Position"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "DFA",
              "NFA",
              "ENFA"
            ],
            "title": "Kind"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "title": "Updatedat"
          },
          "automaton": {
            "$ref": "#/components/schemas/Automaton"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "createdAt",
          "updatedAt",
          "automaton"
        ],
        "title": "Project"
      },
      "ProjectIn": {
        "properties": {
          "automaton": {
            "$ref": "#/components/schemas/Automaton"
          }
        },
        "type": "object",
        "required": [
